        font-size:30px;
    }

    .service-grid{
        grid-template-columns:1fr;
    }

    .stats{
        grid-template-columns:1fr 1fr;
    }

    .portfolio-list{
        grid-template-columns:1fr 1fr;
    }

    .visual{
        height:210px;
    }

    .detail-visual{
        height:300px;
        padding:15px;
    }

}

</style>
