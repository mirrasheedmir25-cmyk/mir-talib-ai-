<script>

/* MOBILE MENU */

function toggleMenu(){

    document
    .getElementById("nav")
    .classList
    .toggle("open");

}


/* OPEN PROJECT */

function openProject(id){

    document
    .querySelectorAll(".project-page")
    .forEach(function(page){

        page.classList.remove("active");

    });


    var page=document.getElementById(id);

    if(page){

        page.classList.add("active");

        window.scrollTo({
            top:page.offsetTop-70,
            behavior:"smooth"
        });

    }

}


/* CLOSE PROJECT */

function closeProjects(){

    document
    .querySelectorAll(".project-page")
    .forEach(function(page){

        page.classList.remove("active");

    });

}


/* CLOSE MOBILE MENU WHEN LINK CLICKED */

document
.querySelectorAll("nav a")
.forEach(function(link){

    link.addEventListener("click",function(){

        document
        .getElementById("nav")
        .classList
        .remove("open");

    });

});

</script>

