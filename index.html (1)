/* ================= PORTFOLIO ================= */

.portfolio-box{
    background:#0b111d;
    border:1px solid #1a2940;
    border-radius:20px;
    padding:25px;
}

.portfolio-title{
    display:flex;
    justify-content:space-between;
    gap:15px;
    align-items:center;
    margin-bottom:20px;
}

.portfolio-list{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:12px;
}

.portfolio-item{
    border:1px solid #1c2d45;
    background:#08101b;
    border-radius:14px;
    padding:18px;
    text-align:center;
}

.portfolio-item .mini{
    height:80px;
    border-radius:10px;
    margin-bottom:12px;
    background:linear-gradient(135deg,#071b2a,#12334c);
    display:flex;
    justify-content:center;
    align-items:center;
    color:#00e5ff;
    font-weight:bold;
}

/* ================= CONTACT ================= */

.contact-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:22px;
}

.contact-item{
    padding:15px 0;
    border-bottom:1px solid #172438;
    color:#b5c1d1;
}

.contact-item a{
    color:#00e5ff;
}

.socials{
    display:flex;
    flex-wrap:wrap;
    gap:10px;
    margin-top:18px;
}

.social{
    padding:10px 14px;
    border:1px solid #293852;
    border-radius:10px;
    color:#aebbd0;
}

.social:hover{
    border-color:#00e5ff;
    color:#00e5ff;
}

/* ================= FOOTER ================= */

footer{
