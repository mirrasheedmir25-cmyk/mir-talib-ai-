        flex-direction:column;
        border-bottom:1px solid #172238;
    }

    nav.open{
        display:flex;
    }

    .menu{
        display:block;
    }

    .about-grid,
    .contact-grid,
    .project-grid{
        grid-template-columns:1fr;
    }

    .service-grid{
        grid-template-columns:repeat(2,1fr);
    }

    .stats{
        grid-template-columns:repeat(2,1fr);
    }

    .portfolio-list{
        grid-template-columns:repeat(2,1fr);
    }

}

@media(max-width:520px){

    .hero{
        min-height:78vh;
    }

