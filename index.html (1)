    margin:auto;
}

/* ================= HEADER ================= */

header{
    position:sticky;
    top:0;
    z-index:999;
    background:rgba(7,10,18,.92);
    backdrop-filter:blur(18px);
    border-bottom:1px solid #172238;
}

.nav{
    height:72px;
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.logo{
    font-size:22px;
    font-weight:900;
    color:#00e5ff;
    letter-spacing:.3px;
}

.logo span{
    color:white;
}

nav{
    display:flex;
    gap:25px;
}

nav a{
    color:#aebbd0;
    font-size:14px;
    transition:.2s;
}

nav a:hover{
    color:#00e5ff;
}

.menu{
    display:none;
    border:1px solid #263653;
    background:#0c1320;
    color:white;
    padding:8px 12px;
    border-radius:10px;
    font-size:20px;
    cursor:pointer;
}

/* ================= HERO ================= */

.hero{
    min-height:88vh;
    display:flex;
    align-items:center;
    text-align:center;
    position:relative;
    overflow:hidden;
}

.hero:before{
    content:"";
    position:absolute;
    width:500px;
    height:500px;
    background:#00e5ff;
    opacity:.08;
    filter:blur(120px);
    border-radius:50%;
    top:-150px;
    left:50%;
    transform:translateX(-50%);
}

.hero-content{
    position:relative;
    z-index:2;
}

.badge{
    display:inline-block;
    padding:8px 15px;
    border-radius:50px;
    border:1px solid #15566a;
    background:#071923;
    color:#00e5ff;
    font-size:13px;
    margin-bottom:22px;
}

.hero h1{
    font-size:clamp(43px,7vw,80px);
    line-height:1.04;
    margin-bottom:24px;
}

.cyan{
    color:#00e5ff;
}

.hero p{
    max-width:720px;
    margin:auto;
    color:#9eacc1;
    font-size:17px;
}

.buttons{
    display:flex;
    justify-content:center;
    gap:12px;
    flex-wrap:wrap;
    margin-top:32px;
}

.btn{
    display:inline-block;
    padding:13px 20px;
    border-radius:12px;
    border:1px solid #293853;
    color:white;
    font-weight:700;
    transition:.2s;
}

.btn:hover{
    transform:translateY(-2px);
    border-color:#00e5ff;
}

.primary{
    background:#00e5ff;
    color:#001014;
    border-color:#00e5ff;
}

/* ================= SECTIONS ================= */

section{
    padding:85px 0;
}

.section-title{
    font-size:36px;
    margin-bottom:10px;
}

.section-sub{
    color:#8797ae;
    margin-bottom:32px;
}

/* ================= ABOUT ================= */

.about-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:25px;
    align-items:center;
}

.about-box,
.info-box,
.contact-box{
    background:#0b111d;
    border:1px solid #1a2940;
    border-radius:20px;
    padding:28px;
}

.about-box p,
.info-box p,
.contact-box p{
    color:#9ba9bd;
}

/* ================= STATS ================= */

.stats{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:15px;
    margin-top:28px;
}

.stat{
    background:#0b111d;
    border:1px solid #1a2940;
    border-radius:16px;
    padding:20px;
    text-align:center;
}

.stat strong{
    display:block;
    color:#00e5ff;
    font-size:27px;
}

.stat span{
    color:#8291a7;
    font-size:13px;
}

/* ================= PROJECTS ================= */

.project-grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:22px;
}

.project{
    background:#0b111d;
    border:1px solid #1a2940;
    border-radius:20px;
    overflow:hidden;
    cursor:pointer;
    transition:.25s;
}

.project:hover{
    transform:translateY(-5px);
    border-color:#00e5ff;
    box-shadow:0 15px 40px rgba(0,229,255,.08);
}

/* PROJECT VISUAL */

.visual{
    height:245px;
    padding:15px;
    background:#050b14;
}

.app{
    height:100%;
    border:1px solid #213452;
    border-radius:12px;
    background:#08101d;
    overflow:hidden;
}

.app-top{
    height:38px;
    display:flex;
    align-items:center;
    padding:0 12px;
    border-bottom:1px solid #1a2b43;
    color:#00e5ff;
    font-weight:bold;
    font-size:13px;
}

.app-body{
    display:grid;
    grid-template-columns:90px 1fr;
    height:calc(100% - 38px);
}

.side{
    border-right:1px solid #1a2b43;
    padding:12px 7px;
}

.side div{
    color:#71839c;
    font-size:9px;
    padding:7px 4px;
    border-radius:5px;
    margin-bottom:4px;
}

.side .active{
    background:#103044;
    color:#00e5ff;
}

.screen{
    padding:13px;
}

.screen-title{
    font-size:16px;
    font-weight:bold;
    margin-bottom:10px;
}

.small-text{
    color:#71839b;
    font-size:9px;
}

.fake-grid{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:7px;
    margin-top:12px;
}

.fake-card{
    height:55px;
    border:1px solid #1e3451;
    background:#0d1725;
    border-radius:7px;
    padding:8px;
    font-size:8px;
    color:#a7b5c7;
}

.fake-chart{
    height:75px;
    margin-top:10px;
    border:1px solid #1c3450;
    border-radius:8px;
    position:relative;
    overflow:hidden;
}

.fake-chart:after{
    content:"";
    position:absolute;
    width:120%;
    height:2px;
    background:#00e5ff;
    top:55%;
    left:-10%;
    transform:rotate(-8deg);
    box-shadow:30px 18px 0 #00e5ff,
               70px -12px 0 #00e5ff,
               110px 10px 0 #00e5ff;
}

.poster{
    background:linear-gradient(135deg,#101b4b,#17266a,#051019);
}

.study{
    background:#f3f6fb;
    color:#152033;
}

.study .app-top{
    color:#126ee8;
}

.study .side{
    border-color:#d8dfeb;
}

.study .side div{
    color:#52647d;
}

.study .side .active{
    background:#dcecff;
    color:#126ee8;
}

.trade{
    background:#041615;
}

.talib{
    background:linear-gradient(135deg,#07152c,#06101e);
